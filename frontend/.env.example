# Aponta para o Django. Em desenvolvimento deixe vazio: o proxy do Vite
# repassa /api para http://127.0.0.1:8000 e você não precisa mexer em CORS.
VITE_API_URL=/api

# Firebase é opcional em desenvolvimento. Sem estas variáveis o app não
# inicializa o Firebase e o backend usa a autenticação de desenvolvimento.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
