# Sem DB_HOST o projeto usa SQLite e sobe sem configurar nada.
DEBUG=1
SECRET_KEY=troque-em-producao

# Supabase (produção) — use o pooler na 6543
# DB_HOST=aws-0-sa-east-1.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.seuprojeto
# DB_PASSWORD=

# REDIS_URL=redis://127.0.0.1:6379/1

# Sem esta variável, a autenticação de desenvolvimento assume (só com DEBUG=1).
# FIREBASE_CREDENTIALS_PATH=/caminho/serviceAccountKey.json

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
