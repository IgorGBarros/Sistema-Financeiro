# ---------------------------------------------------------------------------
# Desenvolvimento: nada aqui é obrigatório.
# Sem DB_HOST o projeto usa SQLite e a autenticação de desenvolvimento.
# ---------------------------------------------------------------------------
SECRET_KEY=troque-em-producao

# Assistente de IA. Sem esta chave o assistente responde 503 com instrução;
# o resto do sistema funciona normalmente.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Produção (DJANGO_SETTINGS_MODULE=config.settings.prod)
# ---------------------------------------------------------------------------
# ALLOWED_HOSTS=api.seudominio.com.br
# CORS_ORIGINS=https://app.seudominio.com.br

# Supabase — use o pooler na 6543, não a conexão direta
# DB_HOST=aws-0-sa-east-1.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.seuprojeto
# DB_PASSWORD=

# REDIS_URL=redis://127.0.0.1:6379/1
# FIREBASE_CREDENTIALS_PATH=/caminho/serviceAccountKey.json
